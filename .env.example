# Copy to apps/web/.env.local (web) and .env (repo root, forecast service / docker compose).
# Never commit real values. Local values come from `supabase status -o env` after `supabase start`.

# ---- Web app (Next.js) -------------------------------------------------------
# Hosted: https://<project-ref>.supabase.co (Project Settings → Data API), nothing after ".co".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: PUBLISHABLE_KEY (or ANON_KEY on older CLIs) from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in legal pages and settings.
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
# Map tiles. OpenStreetMap's own servers are for development only (tile usage policy);
# in production use a provider such as MapTiler or Stadia, e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Show the "Continue with Google" button. Requires the Google provider to be configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---- Supabase CLI (local Google login, optional) -----------------------------
# Also set [auth.external.google] enabled = true in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Forecast service (Python) ------------------------------------------------
FORECAST_INTERNAL_API_KEY=change-me-long-random-string
FORECAST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# ENTSO-E Transparency Platform token (needed from Milestone 2).
ENTSOE_API_TOKEN=

# ---- Tests ----------------------------------------------------------------------
# RLS integration tests (defaults to Supabase local Postgres).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Playwright: Mailpit inbox of the local Supabase stack, and its database (used to promote a test admin).
MAILPIT_URL=http://127.0.0.1:54324
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
